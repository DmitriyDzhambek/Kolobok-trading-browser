{
  "name": "kolobok-trading-browser",
  "version": "1.0.0",
  "description": "Kolobok — Japanese-candle themed trading browser prototype",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5500",
    "dev:electron": "concurrently -k \"vite --host 127.0.0.1 --port 5500\" \"wait-on http://127.0.0.1:5500 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5500 electron .\"",
    "start": "electron .",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5500",
    "serve": "npm run build && vite preview --host 127.0.0.1 --port 5500",
    "vercel:dev": "vercel dev --listen 127.0.0.1:5500",
    "deploy": "vercel --prod",
    "dist": "npm run build && electron-builder"
  },
  "engines": {
    "node": ">=18.14.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "ru.kolobok.tradingbrowser",
    "productName": "Колобок",
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "directories": { "buildResources": "build" },
    "win": { "target": "nsis" }
  }
}